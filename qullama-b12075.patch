+// ggml_compute_forward_qgate (qullama)
+
+// dequantize a gate weight tensor into a row-major F32 buffer
+static void qgate_dequant_gate(const ggml_tensor * g, std::vector<float> & out) {
+    const int64_t n = g->ne[0] * g->ne[1];
+    out.resize(n);
+    switch (g->type) {
+        case GGML_TYPE_F32:
+            memcpy(out.data(), g->data, n * sizeof(float));
+            break;
+        case GGML_TYPE_F16: {
+            const ggml_fp16_t * p = (const ggml_fp16_t *) g->data;
+            for (int64_t i = 0; i < n; ++i) out[i] = ggml_fp16_to_fp32(p[i]);
+        } break;
+        case GGML_TYPE_BF16: {
+            const uint16_t * p = (const uint16_t *) g->data;
+            for (int64_t i = 0; i < n; ++i) {
+                uint32_t u = (uint32_t) p[i] << 16;
+                float f;
+                memcpy(&f, &u, 4);
+                out[i] = f;
+            }
+        } break;
+        case GGML_TYPE_Q8_0:
+            dequantize_row_q8_0((const block_q8_0 *) g->data, out.data(), n);
+            break;
+        case GGML_TYPE_Q4_0:
+            dequantize_row_q4_0((const block_q4_0 *) g->data, out.data(), n);
+            break;
+        default:
+            GGML_ABORT("qgate: unsupported gate tensor type %d", g->type);
+    }
+}
+
+static void qgate_compute_thread(ggml_tensor * dst, const ggml_tensor * state, const ggml_tensor * gate,
+                                 const ggml_tensor * meta, const float * G, int ith, int nth) {
+    const int64_t d2 = state->ne[0];
+    const int64_t d  = d2 / 2;
+    const int64_t nt = state->ne[1] > 0 ? state->ne[1] : 1;
+
+    const int32_t * m  = (const int32_t *) meta->data;
+    const int k  = m[0];
+    const int nc = m[1];
+    const int32_t * targets  = m + 2;
+    const int32_t * controls = m + 2 + k;
+
+    const int gate_dim = (int) gate->ne[0];
+    const int g  = 1 << (k + 1);
+    const int kb = 1 << k;
+
+    const float * src = (const float *) state->data;
+    float       * out = (float *)       dst->data;
+
+    int tmask = 0;
+    for (int j = 0; j < k; ++j) tmask |= 1 << targets[j];
+
+    std::vector<float> in_vec(g), out_vec(g);
+
+    for (int64_t t = 0; t < nt; ++t) {
+        const float * in = src + t * d2;
+        float       * o  = out + t * d2;
+
+        for (int64_t x = ith; x < d; x += nth) {
+            if ((x & tmask) != 0) continue; // handle each block once, at its base
+
+            bool active = true;
+            for (int c = 0; c < nc; ++c) {
+                if (((x >> controls[c]) & 1) == 0) { active = false; break; }
+            }
+            if (!active) {
+                for (int yt = 0; yt < kb; ++yt) {
+                    int64_t y = x;
+                    for (int j = 0; j < k; ++j) if ((yt >> j) & 1) y |= (int64_t) 1 << targets[j];
+                    o[y]     = in[y];
+                    o[d + y] = in[d + y];
+                }
+                continue;
+            }
+            for (int yt = 0; yt < kb; ++yt) {
+                int64_t y = x;
+                for (int j = 0; j < k; ++j) if ((yt >> j) & 1) y |= (int64_t) 1 << targets[j];
+                in_vec[yt]      = in[y];
+                in_vec[kb + yt] = in[d + y];
+            }
+            for (int oo = 0; oo < g; ++oo) {
+                const float * row = G + (int64_t) oo * gate_dim;
+                float acc = 0.0f;
+                for (int i = 0; i < g; ++i) acc += row[i] * in_vec[i];
+                out_vec[oo] = acc;
+            }
+            for (int yt = 0; yt < kb; ++yt) {
+                int64_t y = x;
+                for (int j = 0; j < k; ++j) if ((yt >> j) & 1) y |= (int64_t) 1 << targets[j];
+                o[y]     = out_vec[yt];
+                o[d + y] = out_vec[kb + yt];
+            }
+        }
+    }
+}
+
+void ggml_compute_forward_qgate(
+        const ggml_compute_params * params,
+              ggml_tensor * dst) {
+    const ggml_tensor * state = dst->src[0];
+    const ggml_tensor * gate  = dst->src[1];
+    const ggml_tensor * meta  = dst->src[2];
+    fprintf(stderr, "[qgate fwd] ith=%d nth=%d state ne=%lld,%lld gate ne=%lld,%lld type=%d meta ne=%lld type=%d\n",
+            params->ith, params->nth, (long long) state->ne[0], (long long) state->ne[1],
+            (long long) gate->ne[0], (long long) gate->ne[1], gate->type, (long long) meta->ne[0], meta->type);
+
+    std::vector<float> Gbuf;
+    qgate_dequant_gate(gate, Gbuf);
+    const float * G = Gbuf.data();
+
+    // the graph-level compute already splits nodes across threads; each thread
+    // handles its strided share of block bases via (ith, nth)
+    qgate_compute_thread(dst, state, gate, meta, G, params->ith, params->nth);
+}
