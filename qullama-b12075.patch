diff --git a/ggml/src/ggml-vulkan/vulkan-shaders/qgate.comp b/ggml/src/ggml-vulkan/vulkan-shaders/qgate.comp
new file mode 100644
index 0000000..ed7948e
--- /dev/null
+++ b/ggml/src/ggml-vulkan/vulkan-shaders/qgate.comp
@@ -0,0 +1,76 @@
+#version 450
+
+// qullama QGATE: apply one quantum gate to the state vector.
+// One thread per block base (basis index whose target bits are all zero).
+// State per token column: [Re(d); Im(d)], d = 2^n, qubit i = bit i.
+// gate: row-major real block matrix of the complex gate, stride gate_dim.
+// meta: [k, n_controls, targets..., controls...]
+
+layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
+
+layout(binding = 0) readonly buffer A { float state[]; };
+layout(binding = 1) readonly buffer B { float gate[]; };
+layout(binding = 2) readonly buffer C { int meta[]; };
+layout(binding = 3) writeonly buffer D { float dst[]; };
+
+layout(push_constant) uniform PushConstants {
+    uint d;
+    uint gate_dim;
+    uint nt;
+} pc;
+
+void main() {
+    uint x = gl_GlobalInvocationID.x;
+    if (x >= pc.d) return;
+
+    int k = meta[0];
+    int nc = meta[1];
+
+    uint tmask = 0u;
+    for (int j = 0; j < k; ++j) tmask |= 1u << uint(meta[2 + j]);
+    if ((x & tmask) != 0u) return; // handle each block once, at its base
+
+    bool is_active = true;
+    for (int c = 0; c < nc; ++c) {
+        if (((x >> uint(meta[2 + k + c])) & 1u) == 0u) { is_active = false; break; }
+    }
+
+    int kb = 1 << k;
+    int g = 1 << (k + 1);
+
+    for (uint t = 0u; t < pc.nt; ++t) {
+        uint base = t * 2u * pc.d;
+
+        if (!is_active) {
+            for (int yt = 0; yt < kb; ++yt) {
+                uint y = x;
+                for (int j = 0; j < k; ++j) if (((yt >> j) & 1) != 0) y |= 1u << uint(meta[2 + j]);
+                dst[base + y] = state[base + y];
+                dst[base + pc.d + y] = state[base + pc.d + y];
+            }
+            continue;
+        }
+
+        float in_vec[64];
+        for (int yt = 0; yt < kb; ++yt) {
+            uint y = x;
+            for (int j = 0; j < k; ++j) if (((yt >> j) & 1) != 0) y |= 1u << uint(meta[2 + j]);
+            in_vec[yt] = state[base + y];
+            in_vec[kb + yt] = state[base + pc.d + y];
+        }
+        float out_vec[64];
+        for (int oo = 0; oo < g; ++oo) {
+            float acc = 0.0;
+            for (int i = 0; i < g; ++i) {
+                acc += gate[uint(oo) * pc.gate_dim + uint(i)] * in_vec[i];
+            }
+            out_vec[oo] = acc;
+        }
+        for (int yt = 0; yt < kb; ++yt) {
+            uint y = x;
+            for (int j = 0; j < k; ++j) if (((yt >> j) & 1) != 0) y |= 1u << uint(meta[2 + j]);
+            dst[base + y] = out_vec[yt];
+            dst[base + pc.d + y] = out_vec[kb + yt];
+        }
+    }
+}
