+// qgate: a "model" whose layers are quantum gates applied to a state vector.
+// The state is the embedding of a single token, layout [Re(2^n); Im(2^n)] (n_embd = 2^(n+1)).
+// Each layer applies one gate: blk.i.qgate.weight (F32 [gate_dim, gate_dim], top-left
+// 2^(k+1) x 2^(k+1) block = real form of the complex 2^k x 2^k gate) and
+// blk.i.qgate_meta (I32 [meta_dim]: [k, n_controls, t0..t_{k-1}, c0..c_{m-1}]).
+struct llama_model_qgate : public llama_model_base {
+    llama_model_qgate(const struct llama_model_params & params) : llama_model_base(params) {}
+    void load_arch_hparams(llama_model_loader & ml) override;
+    void load_arch_tensors(llama_model_loader & ml) override;
+
+    uint32_t gate_dim = 0; // padded square size of every blk.i.qgate.weight
+    uint32_t meta_dim = 0; // padded length of every blk.i.qgate_meta
+
+    std::vector<ggml_tensor *> qgate;
+    std::vector<ggml_tensor *> qgate_meta;
+
+    struct graph : public llm_graph_context {
+        graph(const llama_model & model, const llm_graph_params & params);
+    };
+
+    std::unique_ptr<llm_graph_context> build_arch_graph(const llm_graph_params & params) const override;
+};
+
