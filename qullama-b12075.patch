diff --git a/ggml/src/ggml-cuda/qgate.cu b/ggml/src/ggml-cuda/qgate.cu
new file mode 100644
index 0000000..2c9c1e5
--- /dev/null
+++ b/ggml/src/ggml-cuda/qgate.cu
@@ -0,0 +1,91 @@
+// qullama: QGATE op, CUDA kernel. One thread per block base (basis index whose
+// target bits are all zero); the thread gathers the block, multiplies by the
+// gate's real block matrix, and scatters back. Control-off blocks are copied.
+// State layout per token column: [Re(d); Im(d)], d = 2^n; qubit i = bit i.
+
+#include "qgate.cuh"
+
+#define QGATE_MAX_G 64 // supports gates up to k=5 qubits (2^(k+1) <= 64)
+
+__global__ void qgate_kernel(const float * __restrict__ state,
+                             const float * __restrict__ gate,
+                             const int   * __restrict__ meta,
+                             float       * __restrict__ dst,
+                             int64_t d, int gate_dim, int64_t nt) {
+    const int64_t x = (int64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (x >= d) return;
+
+    const int k  = meta[0];
+    const int nc = meta[1];
+    const int * targets  = meta + 2;
+    const int * controls = meta + 2 + k;
+
+    const int g  = 1 << (k + 1);
+    const int kb = 1 << k;
+    GGML_ASSERT(g <= QGATE_MAX_G);
+
+    int tmask = 0;
+    for (int j = 0; j < k; ++j) tmask |= 1 << targets[j];
+    if (x & tmask) return; // handle each block once, at its base
+
+    bool active = true;
+    for (int c = 0; c < nc; ++c) {
+        if (((x >> controls[c]) & 1) == 0) { active = false; break; }
+    }
+
+    for (int64_t t = 0; t < nt; ++t) {
+        const float * in  = state + t * 2 * d;
+        float       * out = dst   + t * 2 * d;
+
+        if (!active) {
+            for (int yt = 0; yt < kb; ++yt) {
+                int64_t y = x;
+                for (int j = 0; j < k; ++j) if ((yt >> j) & 1) y |= (int64_t) 1 << targets[j];
+                out[y]     = in[y];
+                out[d + y] = in[d + y];
+            }
+            continue;
+        }
+
+        float in_vec[QGATE_MAX_G];
+        for (int yt = 0; yt < kb; ++yt) {
+            int64_t y = x;
+            for (int j = 0; j < k; ++j) if ((yt >> j) & 1) y |= (int64_t) 1 << targets[j];
+            in_vec[yt]      = in[y];
+            in_vec[kb + yt] = in[d + y];
+        }
+        float out_vec[QGATE_MAX_G];
+        for (int oo = 0; oo < g; ++oo) {
+            const float * row = gate + (int64_t) oo * gate_dim;
+            float acc = 0.0f;
+            for (int i = 0; i < g; ++i) acc += row[i] * in_vec[i];
+            out_vec[oo] = acc;
+        }
+        for (int yt = 0; yt < kb; ++yt) {
+            int64_t y = x;
+            for (int j = 0; j < k; ++j) if ((yt >> j) & 1) y |= (int64_t) 1 << targets[j];
+            out[y]     = out_vec[yt];
+            out[d + y] = out_vec[kb + yt];
+        }
+    }
+}
+
+void ggml_cuda_op_qgate(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * state = dst->src[0];
+    const ggml_tensor * gate  = dst->src[1];
+    const ggml_tensor * meta  = dst->src[2];
+
+    GGML_ASSERT(state->type == GGML_TYPE_F32);
+    GGML_ASSERT(gate->type == GGML_TYPE_F32); // quantized gates are handled on CPU
+    GGML_ASSERT(meta->type == GGML_TYPE_I32);
+
+    const int64_t d  = state->ne[0] / 2;
+    const int64_t nt = state->ne[1] > 0 ? state->ne[1] : 1;
+    const int gate_dim = (int) gate->ne[0];
+
+    const int threads = 256;
+    const int64_t blocks = (d + threads - 1) / threads;
+    qgate_kernel<<<blocks, threads, 0, ctx.stream>>>(
+        (const float *) state->data, (const float *) gate->data, (const int *) meta->data,
+        (float *) dst->data, d, gate_dim, nt);
+}
