@@ -6267,6 +6269,27 @@ struct ggml_tensor * ggml_map_custom3(
     return ggml_map_custom3_impl(ctx, a, b, c, fun, n_tasks, userdata, false);
 }
 
+// qullama: quantum gate application (see ggml.h for the tensor contract)
+struct ggml_tensor * ggml_qgate(
+        struct ggml_context * ctx,
+        struct ggml_tensor * a,
+        struct ggml_tensor * gate,
+        struct ggml_tensor * meta) {
+    GGML_ASSERT(a->type == GGML_TYPE_F32);
+    GGML_ASSERT(ggml_is_matrix(a));
+    GGML_ASSERT(ggml_is_quantized(gate->type) || gate->type == GGML_TYPE_F32 || gate->type == GGML_TYPE_F16 || gate->type == GGML_TYPE_BF16);
+    GGML_ASSERT(ggml_is_matrix(gate));
+    GGML_ASSERT(meta->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_vector(meta));
+
+    struct ggml_tensor * result = ggml_dup_tensor(ctx, a);
+    result->op     = GGML_OP_QGATE;
+    result->src[0] = a;
+    result->src[1] = gate;
+    result->src[2] = meta;
+    return result;
+}
