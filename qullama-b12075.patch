+void ggml_vk_qgate(ggml_backend_vk_context * ctx, vk_context& subctx, const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * src2, ggml_tensor * dst) {
+    // qullama: src0 = state (F32), src1 = gate matrix (F32), src2 = meta (I32)
+    GGML_ASSERT(src0->type == GGML_TYPE_F32 && src1->type == GGML_TYPE_F32 && src2->type == GGML_TYPE_I32);
+    GGML_ASSERT(src1->ne[0] <= 64); // shader's fixed-size gate buffer
+
+    vk_pipeline pipeline = ctx->device->pipeline_qgate_f32;
+    GGML_ASSERT(pipeline != nullptr);
+
+    ggml_pipeline_request_descriptor_sets(ctx, pipeline, 1);
+
+    vk_op_qgate_push_constants pc = {};
+    pc.d = (uint32_t) (src0->ne[0] / 2);
+    pc.gate_dim = (uint32_t) src1->ne[0];
+    pc.nt = (uint32_t) (src0->ne[1] > 0 ? src0->ne[1] : 1);
+
+    vk_subbuffer state_buf = ggml_vk_tensor_subbuffer(ctx, src0);
+    vk_subbuffer gate_buf  = ggml_vk_tensor_subbuffer(ctx, src1);
+    vk_subbuffer meta_buf  = ggml_vk_tensor_subbuffer(ctx, src2);
+    vk_subbuffer dst_buf   = ggml_vk_tensor_subbuffer(ctx, dst);
+
+    ggml_vk_dispatch_pipeline(ctx, subctx, pipeline, { state_buf, gate_buf, meta_buf, dst_buf }, pc, { pc.d, 1, 1 });
+}
